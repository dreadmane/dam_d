{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills.schema.json",
  "title": "skills.json: the 18 skills",
  "description": "Each skill with its ability and what it covers. A character's proficiency state (none, proficient, Expertise) is the save's, never this file's.",
  "type": "object",
  "required": ["meta", "skills", "rules"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/meta" },
    "skills": {
      "type": "array", "minItems": 18, "maxItems": 18,
      "items": {
        "type": "object",
        "required": ["id", "name", "ability", "examples", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/skill" },
          "name": { "type": "string" },
          "ability": { "$ref": "common.schema.json#/$defs/ability" },
          "examples": { "type": "string", "description": "The Skills table's example uses." },
          "source": { "$ref": "common.schema.json#/$defs/source" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "note": { "type": "string" }
        }
      }
    },
    "rules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/rule" } },
    "ambiguities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ambiguity" } }
  }
}
