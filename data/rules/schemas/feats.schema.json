{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feats.schema.json",
  "title": "feats.json: the feats",
  "description": "Each feat's category, prerequisite, repeatability, text and effects. An Ability Score Increase a feat grants is an abilityIncrease effect.",
  "type": "object",
  "required": ["meta", "feats"],
  "additionalProperties": false,
  "properties": {
    "meta": { "$ref": "common.schema.json#/$defs/meta" },
    "feats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "repeatable", "text", "effects", "source", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "name": { "type": "string" },
          "category": { "enum": ["origin", "general", "fighting-style", "epic-boon"] },
          "prerequisite": { "$ref": "common.schema.json#/$defs/prerequisite" },
          "repeatable": {
            "type": "object", "required": ["allowed"], "additionalProperties": false,
            "properties": { "allowed": { "type": "boolean" }, "text": { "type": "string" } }
          },
          "text": { "$ref": "common.schema.json#/$defs/text" },
          "effects": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/effect" } },
          "action": { "$ref": "common.schema.json#/$defs/actionType", "description": "Added 2026-10-20 (user): what using the feat's limited benefit costs, as a class feature's action, so the turn can group it." },
          "source": { "$ref": "common.schema.json#/$defs/source" },
          "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
          "note": { "type": "string" }
        },
        "allOf": [ { "if": { "properties": { "confidence": { "not": { "const": "printed" } } } }, "then": { "required": ["note"] } } ]
      }
    },
    "rules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/rule" } },
    "ambiguities": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ambiguity" } }
  }
}
