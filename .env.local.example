# Copy this file to .env.local (git-ignored by the *.local rule) and set the
# workspace paths on this machine. npm run sync-data reads RULES_DATA_DIR;
# npm run sync-tokens reads TOKENS_DIR. No quotes needed, and backslashes are
# fine.
RULES_DATA_DIR=C:\path\to\ttrpg-apps\domains\dnd-rules\data
TOKENS_DIR=C:\path\to\ttrpg-apps\domains\dnd-design\tokens
